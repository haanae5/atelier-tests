{
  "name": "atelier-tests",
  "version": "1.0.0",
  "description": "Atelier sur la pyramide de tests",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:unit": "jest tests/unit --coverage",
    "test:int": "jest tests/integration --runInBand",
    "test:e2e": "playwright test"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "devDependencies": {
    "jest": "^30.5.2"
  }
}
